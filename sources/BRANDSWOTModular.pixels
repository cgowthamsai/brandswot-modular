# ---------------------------------------------------------------------------
# Marks. cc = column of the mark that sits over the base's centre column.
# Marks are drawn once here and reused for every accented letter,
# the spacing accents (acute, dieresis…) and the combining marks (U+03xx).
# ---------------------------------------------------------------------------

mark grave cc=1 pos=top
#.
.#

mark acute cc=0 pos=top
.#
#.

mark circumflex cc=1 pos=top
.#.
#.#

mark caron cc=1 pos=top
#.#
.#.

mark breve cc=1 pos=top
#.#
###

mark tilde cc=2 pos=top
.#..#
#.##.

mark macron cc=1 pos=top
###

mark dieresis cc=1 pos=top
#.#

mark dotaccent cc=0 pos=top
#

mark ring cc=1 pos=top
###
#.#
###

mark hungarumlaut cc=1 pos=top
.#.#
#.#.

mark cedilla cc=0 pos=bottom
.#
##

mark commaaccent cc=1 pos=bottom
.#
#.

mark ogonek cc=0 pos=ogonek
#.
.#

mark commaturned cc=0 pos=top
.#
#.
